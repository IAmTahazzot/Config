{
  // Launch size
  "window.newWindowDimensions": "inherit",
  // General Editor Settings
  "editor.tabSize": 2,
  "editor.rulers": [
    80
  ],
  "editor.lineNumbers": "off",
  "editor.wordWrap": "on",
  "editor.renderWhitespace": "trailing",
  "editor.cursorStyle": "block",
  "editor.roundedSelection": false,
  "editor.suggest.shareSuggestSelections": true,
  "editor.lineHeight": 1.6,
  "editor.guides.highlightActiveIndentation": false,
  "editor.minimap.enabled": false,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.stickyScroll.enabled": false,
  "editor.detectIndentation": false,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.compactFolders": false,
  // Workbench Settings
  "workbench.startupEditor": "none",
  "workbench.editor.empty.hint": "hidden",
  "workbench.editorAssociations": {
    "git-rebase-todo": "gitlens.rebase",
    "*.svg": "default"
  },
  "workbench.colorCustomizations": {
    "editorRuler.foreground": "#2e2e44"
  },
  // Window Settings
  "window.title": "${activeEditorMedium}",
  // Terminal Settings
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "terminal.integrated.fontFamily": "'FiraCode Nerd Font', Consolas",
  "terminal.integrated.fontSize": 12,
  // Language Specific Settings
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.tabSize": 4
  },
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.tabSize": 4
  },
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.tabSize": 4
  },
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "scss.lint.unknownAtRules": "ignore",
  "less.lint.unknownAtRules": "ignore",
  "css.lint.unknownAtRules": "ignore",
  // Extension Specific Settings
  "[prisma]": {
    "editor.defaultFormatter": "Prisma.prisma"
  },
  "vim.foldfix": true,
  "vim.ignorecase": false,
  "vim.enableNeovim": true,
  "security.workspace.trust.untrustedFiles": "open",
  "debug.console.acceptSuggestionOnEnter": "on",
  "github.copilot.enable": {
    "*": false,
    "plaintext": true,
    "markdown": false,
    "scminput": false
  },
  "extensions.ignoreRecommendations": true,
  "[svg]": {
    "editor.defaultFormatter": "jock.svg"
  },
  "[php]": {
    "editor.defaultFormatter": "bmewburn.vscode-intelephense-client",
    "editor.tabSize": 4
  },
  "[sql]": {
    "editor.defaultFormatter": "inferrinizzard.prettier-sql-vscode"
  },
  "breadcrumbs.enabled": false,
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "[astro]": {
    "editor.defaultFormatter": "astro-build.astro-vscode"
  },
  "javascript.updateImportsOnFileMove.enabled": "always",
  "material-icon-theme.folders.theme": "specific",
  "diffEditor.codeLens": true,
  "[dockerfile]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-docker"
  },
  "window.commandCenter": false,
  "editor.lightbulb.enabled": "off",
  "terminal.integrated.cursorBlinking": true,
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[go]": {
    "editor.defaultFormatter": "golang.go"
  },
  "C_Cpp.default.cppStandard": "c++20",
  "[markdown]": {
    "editor.defaultFormatter": "denoland.vscode-deno"
  },
  "go.toolsManagement.autoUpdate": true,
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "chat.commandCenter.enabled": false,
  "workbench.editor.editorActionsLocation": "hidden",
  "workbench.layoutControl.enabled": false,
  "[swift]": {
    "editor.defaultFormatter": "swiftlang.swift-vscode"
  },
  "editor.guides.indentation": false,
  "workbench.tree.indent": 10,
  "[csv]": {
    "editor.inlayHints.maximumLength": 0
  },
  "workbench.colorTheme": "Moonlight II Italic",
  "github.copilot.nextEditSuggestions.enabled": true,
  "[scss]": {
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  "editor.fontFamily": "\"FiraCode Nerd Font\", monospace",
  "editor.allowVariableFontsInAccessibilityMode": true,
  "workbench.iconTheme": "material-icon-theme",
  "editor.fontLigatures": true,
  "window.menuBarVisibility": "compact",
  "editor.fontSize": 13,
  "markdown.preview.fontFamily": "Plus Jakarta Sans",
  "markdown.preview.doubleClickToSwitchToEditor": false,
  "markdown.preview.fontSize": 13,
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "chat.editor.fontSize": 13,
  "chat.agentSessionsViewLocation": "view",
  "go.useLanguageServer": true,
  "go.alternateTools": {
    "go-langserver": "gopls"
  },
  "workbench.activityBar.location": "hidden"
}
